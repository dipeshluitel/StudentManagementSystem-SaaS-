@model BasicForm.Models.MyForm

@* @{ *@
@*     Layout = null; *@
@* } *@

<!DOCTYPE html>

<html lang="en">
<head>
    <title>Form</title>
</head>
<body>
<div>
  <form method="post">
        <div class="mb-3">
            <label for="username" class="form-label">Institution Name:</label>
            <input type="text" class="form-control" id="username" aria-describedby="emailHelp" asp-for="Username"/>
        </div>
        
        <div class="mb-3">
            <label for="exampleInputEmail1" class="form-label">Email address</label>
            <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" asp-for="Email"/>
            <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
        </div>
        
        <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label">Password</label>
            <input type="password" class="form-control" id="exampleInputPassword1" asp-for="Password"/>
        </div>
        <div class="mb-3 form-check">
            <label class="form-label" for="total_stu">Present number of students</label>
            <input type="number" class="form-check-input" id="total_stu">
        </div>
        <div class="mb-3 form-check">
            <label class="form-label" for="total_tea">Present number of Teachers</label>
            <input type="number" class="form-check-input" id="total_tea">
        </div>
        <div class="mb-3 form-check">
            <label class="form-label" for="total_course">Total Courses you provide</label>
            <input type="number" class="form-check-input" id="total_course">
        </div>
        <div class="mb-3 form-check">
            <label class="form-label" for="total_exam">Total Exam your institution take</label>
            <input type="number" class="form-check-input" id="total_exam">
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
        
    </form>
</div>
</body>
</html>